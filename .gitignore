# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Environment / secrets
.env
.env.*
!.env.example

# Databases
*.db
*.sqlite
*.sqlite3

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# IDE / editor
# Ignore .vscode contents but keep the shared settings.json.
# Must be `.vscode/*`, not `.vscode/` - git will not descend into an
# ignored directory, so a negation inside it would never be evaluated.
.vscode/*
!.vscode/settings.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini
